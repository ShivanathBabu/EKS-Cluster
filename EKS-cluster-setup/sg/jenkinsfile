pipeline {
    agent {
        label 'AGENT-1'
    }

     options {
        // Timeout counter starts AFTER agent is allocated
        timeout(time: 30, unit: 'MINUTES')
        disableConcurrentBuilds()
        ansiColor('xterm')
    }

    environment {
        appVersion = ''
        Region = 'us-east-1'
        ACC_ID = '139355608147'
        PROJECT = 'roboshop'
        COMPONENT = 'Roboshop'
    }

    stages {
        stage ('init') {
            steps {
               script {
                    withAWS(credentials: 'aws-creds', region: 'us-east-1') {
                        sh """
                            cd EKS-cluster-setup/sg
                            terraform init
                        """
                    }
                  }
                }
            }

            stage ('plan') {
            steps {
               script {
                    withAWS(credentials: 'aws-creds', region: 'us-east-1') {
                        sh """
                            cd EKS-cluster-setup/sg
                            terraform plan
                        """
                    }
                  }
                }
            }


            stage ('apply') {
                 input {
                message "Should we continue?"
                ok "Yes, we should."
                submitter "shivanath"

            }
            steps {
               script {
                    withAWS(credentials: 'aws-creds', region: 'us-east-1') {
                        sh """
                            cd EKS-cluster-setup/sg
                            terraform apply -auto-approve
                
                        """
                    }
                  }
                }

            }

            // stage ('destroy') {
            //     steps {
            //         script {
            //             sh """
            //                 cd EKS-cluster-setup/sg
            //                 terraform destroy -auto-approve
            //             """
            //         }
            //     }
            // }

            stage ('Bastion EKS ACM ALB') {
                parallel {
                    stage('Trigger Bastion') {
                        steps {
                            script {
                                build job: 'bastion',
                                      propagate: false,
                                      wait: false
                            }
                        }
                    }

                     stage('Trigger EKS') {
                        steps {
                            script {
                                build job: 'eks',
                                      propagate: false,
                                      wait: false
                            }
                        }
                    }

                    stage('Trigger ACM') {
                      // sequential  
                        steps {
                            script {
                                build job: 'acm',
                                      propagate: false,
                                      wait: false
                                     }
                                }       
                    }
                }
            }
               stage('alb') {
                        steps {
                                script {
                                        build job: 'frontend-alb',
                                              propagate: false,
                                              wait: false
                                     }
                                }
                            }

        
            
        }

   

  
    }
