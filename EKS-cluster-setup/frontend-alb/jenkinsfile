pipeline {
    agent {
        label 'AGENT-1'
    }

     options {
        // Timeout counter starts AFTER agent is allocated
        timeout(time: 30, unit: 'MINUTES')
        disableConcurrentBuilds()
        ansiColor('xterm')
    }

    environment {
        appVersion = ''
        Region = 'us-east-1'
        ACC_ID = '139355608147'
        PROJECT = 'roboshop'
        COMPONENT = 'Roboshop'
    }

    stages {
        stage ('init') {
            steps {
               script {
                    withAWS(credentials: 'aws-creds', region: 'us-east-1') {
                        sh """
                            cd EKS-cluster-setup/frontend-alb
                            terraform init
                        """
                    }
                  }
                }
            }

            stage ('plan') {
            steps {
               script {
                    withAWS(credentials: 'aws-creds', region: 'us-east-1') {
                        sh """
                            cd EKS-cluster-setup/frontend-alb
                            terraform plan
                        """
                    }
                  }
                }
            }


            stage ('apply') {
              
            
            steps {
               script {
                    withAWS(credentials: 'aws-creds', region: 'us-east-1') {
                        sh """
                            cd EKS-cluster-setup/frontend-alb
                            terraform apply -auto-approve
                
                        """
                    }
                  }
                }
            }

            stage ('destroy') {
              
            
            steps {
               script {
                    withAWS(credentials: 'aws-creds', region: 'us-east-1') {
                        sh """
                            cd EKS-cluster-setup/frontend-alb
                            terraform destroy -auto-approve
                
                        """
                    }
                  }
                }
            }
          
        }
}
   

       

  
    
